[Desktop Entry]
Version=1.0
Type=Application
Name=Matrix 主线 (BFM-SONIC)
Comment=启动当前已验收的 Matrix BFM-SONIC / Isaac world16 主线
Exec=@MATRIX_START_EXEC@
Icon=@MATRIX_ICON@
Terminal=false
StartupNotify=false
Categories=Game;
Actions=Status;Stop;
X-Matrix-Release-Channel=qualified-mainline
X-Matrix-Active-Root=@MATRIX_ACTIVE_ROOT@
X-Matrix-Profile=@MATRIX_PROFILE@

[Desktop Action Status]
Name=查看 Matrix 主线状态
Exec=@MATRIX_STATUS_EXEC@

[Desktop Action Stop]
Name=安全停止 Matrix 主线
Exec=@MATRIX_STOP_EXEC@
