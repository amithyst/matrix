[Desktop Entry]
Version=1.0
Type=Application
Name=@MATRIX_NAME@
Comment=@MATRIX_COMMENT@
Exec=@MATRIX_START_EXEC@
Icon=@MATRIX_ICON@
Terminal=false
StartupNotify=false
Categories=Game;
Actions=Status;Stop;
X-Matrix-Repository=@MATRIX_REPOSITORY@
X-Matrix-Profile=@MATRIX_PROFILE@
X-Matrix-Scene=@MATRIX_SCENE@

[Desktop Action Status]
Name=Show Matrix SONIC Status
Exec=@MATRIX_STATUS_EXEC@

[Desktop Action Stop]
Name=Stop Matrix SONIC
Exec=@MATRIX_STOP_EXEC@
